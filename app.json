{
  "expo": {
    "name": "Orbit Breaker",
    "slug": "orbit-breaker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/orbit_breaker_icon.jpg",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/orbit_breaker_splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1020"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dreamcall.orbitbreaker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0B1020"
      },
      "package": "com.dreamcall.orbitbreaker",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/orbit_breaker_icon.jpg"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.gl.** { *; }\n-keep interface expo.modules.gl.** { *; }\n-keepclasseswithmembernames class * { native <methods>; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class com.facebook.react.bridge.** { *; }\n-keep class com.google.android.gms.ads.** { *; }\n-keep class com.google.ads.** { *; }"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8540104953749120~3044299378",
          "iosAppId": "ca-app-pub-8540104953749120~3044299378"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/orbit_breaker_splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B1020"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ccf389fa-73ae-4b78-a0d0-6c458f8a5062"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-8540104953749120~3044299378",
    "ios_app_id": "ca-app-pub-8540104953749120~3044299378"
  }
}
